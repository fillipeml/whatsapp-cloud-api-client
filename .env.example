# =============================================================================
# whatsapp-cloud-api-client. Copy to ".env" and fill in. NEVER commit the .env files.
# The demo (`wa-groups demo`) needs none of these.
# =============================================================================

# --- Safety ------------------------------------------------------------------------
# true (the default) = reads go to the API for real, and every write is recorded and
# withheld. That combination is what makes a provisioning script safe to point at
# production before it is trusted. Sending for real has to be typed.
WA_DRY_RUN=true

# --- Credentials -------------------------------------------------------------------
# The business phone number's id, and a token with whatsapp_business_messaging.
# The Groups API additionally requires the number to hold Official Business Account
# status; Meta does not grant it to test accounts, so there is no sandbox.
WA_PHONE_NUMBER_ID=
WA_TOKEN=

# --- Webhooks ----------------------------------------------------------------------
# The app secret signs every delivery. With it unset, this client refuses every
# delivery rather than trusting it: an endpoint that skips the check because a variable
# is missing is an open event injector.
WA_APP_SECRET=
# Any string you choose. Meta echoes it back once, during the subscription handshake.
WA_VERIFY_TOKEN=

# --- Graph API ---------------------------------------------------------------------
# Configuration, not a constant in the source: versions expire on a published schedule,
# so a pinned one is wrong from the day it ships. Default is v26.0.
WA_GRAPH_VERSION=v26.0

# --- Pacing ------------------------------------------------------------------------
# Retries apply to 429 and 5xx only; a 400 will be a 400 next time. Meta's own
# Retry-After header wins over this schedule whenever it is sent.
WA_TIMEOUT_SECONDS=30
WA_RETRY_ATTEMPTS=4
WA_RETRY_BASE_SECONDS=1
WA_RETRY_MAX_SECONDS=60
